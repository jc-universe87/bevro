# Bevro configuration. Copy to .env and change what you need.
# Everything here is optional: a fresh clone runs with this file absent.
# docker-compose.yml and scripts/worker.sh both read .env.

# --- Ports on your machine ---------------------------------------------------
BEVRO_WEB_PORT=6140          # the Bevro web app: http://localhost:6140
BEVRO_API_PORT=6141          # the API (Swagger UI at /docs)
BEVRO_DB_PORT=6142           # PostgreSQL, for tools and the optional worker
# Which address the ports are published on. The default keeps Bevro on this
# machine only. Bevro has no login: read SECURITY.md before changing it.
BEVRO_BIND=127.0.0.1

# --- File ownership -----------------------------------------------------------
# The API container runs as this user so that files it writes under ./data
# belong to you. Match `id -u` / `id -g` if they are not 1000.
BEVRO_UID=1000
BEVRO_GID=1000

# --- Demo ---------------------------------------------------------------------
# A normal workspace starts empty: its agents are the ones you connect or
# create. Turn this on to also register Bevro's two example providers
# (Research and the Calendar Demo) for a look around, a screenshot or
# a walkthrough. Turning it off again takes them back out.
BEVRO_DEMO_MODE=false

# --- Secrets ----------------------------------------------------------------
# Key used to encrypt provider credentials at rest (Fernet: 44 url-safe base64
# characters). Leave empty in development: a key is generated once into
# data/secret.key. Set it explicitly for anything shared or long-lived:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing the key makes previously stored credentials unreadable.
BEVRO_SECRET_KEY=

# --- Routing ----------------------------------------------------------------
# How Bevro decides which agent takes a request typed on Home.
#   deterministic  (default) local keyword rules; nothing leaves this machine.
#   llm            send the request plus a sanitised list of your agents (names,
#                  descriptions, capabilities, availability - never secrets,
#                  paths or endpoints) to a routing model, which returns a
#                  structured choice that Bevro validates. Falls back to the
#                  local rules if the model is slow, unreachable or wrong.
BEVRO_ROUTER_MODE=deterministic
# Backend: "openai" (OpenAI, or any OpenAI-compatible server such as vLLM,
# Ollama or LiteLLM via BEVRO_ROUTER_BASE_URL) or "anthropic".
BEVRO_ROUTER_BACKEND=openai
# Small, cheap models are enough; routing is classification, not execution.
# Defaults: gpt-4o-mini (openai), claude-haiku-4-5-20251001 (anthropic).
BEVRO_ROUTER_MODEL=
BEVRO_ROUTER_API_KEY=
# Leave empty for the vendor's API. Set to a local server for offline routing,
# e.g. http://localhost:11434/v1 (Ollama) with the openai backend.
BEVRO_ROUTER_BASE_URL=
# Home never waits longer than this for a routing answer before falling back.
BEVRO_ROUTER_TIMEOUT_SECONDS=8

# --- Connect (local agents and projects) -------------------------------------
# Folders Bevro may look inside and run things in when you type a local path
# or a command on the Connect screen. ":"-separated, ~ allowed. Discovery is
# read-only and never writes into these projects. Empty means: local Connect
# is off (web addresses and MCP servers still work). The worker reads this.
BEVRO_LOCAL_ROOTS=
# When routing is in llm mode, the same model may refine a discovered agent's
# name, description and capabilities from a sanitised summary (never source
# files, .env contents or paths). Set to "off" to keep discovery fully local.
BEVRO_DISCOVERY_ASSIST=auto
# An agent may be reachable more than one way (a running service and the
# project it lives in, say). When one is down, Bevro quietly uses the next.
# A run that timed out may already be doing real work, so it is not tried
# elsewhere unless you turn this on.
BEVRO_RUNTIME_FALLBACK_ON_TIMEOUT=false

# --- Notifications ----------------------------------------------------------
# Bevro always tells you inside Bevro. Everything below is optional: with none
# of it set, monitoring still works and nothing is ever sent anywhere.
# Where this Bevro can be reached, so a message can link back to the result.
BEVRO_APP_URL=http://localhost:6140
# Email. Ordinary mail-server settings; nothing Bevro-specific. Port 465 uses
# TLS from the start, anything else tries STARTTLS. A local test server
# (python -m aiosmtpd -n -l localhost:1025) works with host+port alone.
BEVRO_SMTP_HOST=
BEVRO_SMTP_PORT=587
BEVRO_SMTP_USERNAME=
BEVRO_SMTP_PASSWORD=
BEVRO_SMTP_FROM=
BEVRO_SMTP_STARTTLS=true
# Who Bevro writes to. Without it, email is not offered at all.
BEVRO_NOTIFY_EMAIL=
# A web address of your own to post events to, as small stable JSON. Optional.
BEVRO_NOTIFY_WEBHOOK_URL=
# Set this and every post carries an X-Bevro-Signature (HMAC-SHA256) the
# receiver can check, so it knows the message is yours and is not a replay.
BEVRO_NOTIFY_WEBHOOK_SECRET=

# --- Worker (optional; coding providers such as Claude Code) ----------------
# The worker runs on the host (scripts/worker.sh). These defaults match the
# Docker stack above; only change them if you moved something.
#BEVRO_WORKER_DATABASE_URL=postgresql+psycopg://bevro:bevro@localhost:6142/bevro
#BEVRO_WORKER_ARTIFACT_DIR=./data/artifacts
#BEVRO_WORKER_LOG_DIR=./data/logs
#BEVRO_WORKER_WORKSPACES_FILE=./config/workspaces.json
#BEVRO_WORKER_SECRET_KEY_FILE=./data/secret.key
#BEVRO_WORKER_INTEGRATIONS_DIR=./data/integrations
# A running job whose worker has not reported for this long is presumed dead.
BEVRO_WORKER_STALE_SECONDS=90

# --- Inside the containers (rarely changed) ---------------------------------
# These are set in docker-compose.yml and documented here for completeness:
#   BEVRO_DATABASE_URL     postgresql+psycopg://bevro:bevro@db:5432/bevro
#   BEVRO_ARTIFACT_DIR     /data/artifacts   (bind-mounted from ./data)
#   BEVRO_LOG_DIR          /data/logs
#   BEVRO_INTEGRATIONS_DIR /data/integrations  (Bevro-side storage for connected providers)
#   BEVRO_WORKSPACES_FILE  /srv/config/workspaces.json  (from ./config, optional)
#   BEVRO_CORS_ORIGINS     http://localhost:${BEVRO_WEB_PORT}
